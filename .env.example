# Copy to .env (compose loads it automatically) and fill in the keys you have.
# Keys are only ever used server-side to call the provider APIs.

# --- providers ---------------------------------------------------------------
# Alibaba Cloud Model Studio — Token Plan (Personal Edition, Qwen)
# https://modelstudio.console.alibabacloud.com/subscription/overview
# The sk-sp- key proves the subscription is alive and lists its models. Credits
# usage itself is only visible in the console — Alibaba exposes no API for it.
# Keys are region-bound: international plans use the Singapore host, China plans
# the Beijing one; ALIBABA_TOKEN_PLAN_REGION=china (or the BASE_URL below) switches.
ALIBABA_TOKEN_PLAN_API_KEY=
#ALIBABA_TOKEN_PLAN_REGION=international   # or: china
#ALIBABA_TOKEN_PLAN_BASE_URL=https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1

# https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# https://openrouter.ai/settings/keys
# A normal key shows the per-key limit/usage; a *management* key additionally
# unlocks account-wide credits purchased/used.
OPENROUTER_API_KEY=

# https://platform.openai.com/api-keys
# OpenAI only exposes spend to *admin* keys (sk-admin-…). Put one here and it is
# preferred for both endpoints; a normal project key still validates and shows a
# "billing needs an admin key" note.
OPENAI_ADMIN_KEY=
#OPENAI_API_KEY=

# How many days of OpenAI spend to show. Default 30 (max 180).
#OPENAI_COST_WINDOW_DAYS=30

# https://console.anthropic.com/settings/admin-keys
# Anthropic's Usage & Cost Admin API needs an *admin* credential (sk-ant-admin01-…).
# A standard key still validates and explains that billing is out of reach.
ANTHROPIC_ADMIN_KEY=
#ANTHROPIC_API_KEY=

# Days of Anthropic spend to show. Default 30 (the cost report caps at 31 days).
#ANTHROPIC_COST_WINDOW_DAYS=30

# https://platform.moonshot.ai/console/api-keys   (KIMI_API_KEY also works)
# A plain API key can read its own balance — no admin credential needed.
# Keys are region-bound: an international key must use api.moonshot.ai (USD), a
# China-issued key api.moonshot.cn (CNY). The app probes the other region if the
# configured one returns 401, and says so.
MOONSHOT_API_KEY=
#MOONSHOT_REGION=international   # or: china
#MOONSHOT_BASE_URL=https://api.moonshot.ai/v1

# --- optional ----------------------------------------------------------------
# Interface the dashboard is published on.
# Default 127.0.0.1 = this host only. Set it to this host's LAN IP to reach the
# dashboard from your phone/laptop, e.g. CREDIT_WATCH_BIND=192.0.2.50
# (find it with: ip -4 -o addr show scope global). Never 0.0.0.0.
# ./run.sh writes this for you: it detects the host's LAN IP and publishes there.
# WARNING: on a LAN, anything on that network can read these balances — set
# BASIC_AUTH_USER/PASSWORD below, and/or firewall the port.
#CREDIT_WATCH_BIND=127.0.0.1

# Host port (published on the interface above). Default 8760.
#CREDIT_WATCH_PORT=8760

# Seconds to cache provider responses. Default 60.
#CACHE_TTL_SECONDS=60

# Per-request timeout for provider APIs. Default 15.
#HTTP_TIMEOUT_SECONDS=15

# Refresh abuse protection. Each refresh=true request costs a provider API call, so:
#   - one upstream refresh per client every N seconds (default 10)
#   - at most M upstream refreshes per minute overall (default 20)
# Cached reads (page load, auto-refresh, extra tabs) are never limited.
# Set both to 0 to disable.
#REFRESH_MIN_INTERVAL_SECONDS=10
#REFRESH_MAX_PER_MINUTE=20

# Providers without a key are listed in a one-line footer note ("Not configured: …"),
# not as cards. Set this to true to get a placeholder card per provider instead.
#SHOW_UNCONFIGURED=false

# Put the dashboard behind HTTP Basic auth (starts empty = open to anyone who can
# reach the port — set this whenever you publish on a LAN or proxy).
#BASIC_AUTH_USER=
#BASIC_AUTH_PASSWORD=

# Read keys from a file instead of the environment (one KEY=value per line).
#Docker default candidate: /run/secrets/credit-watch.env
#KEYS_FILE=/run/secrets/credit-watch.env

# Page title.
#APP_TITLE=AI Credit Watch

# Only for self-hosted / proxied OpenAI-compatible gateways:
#DEEPSEEK_API_BASE=https://api.deepseek.com
#OPENROUTER_API_BASE=https://openrouter.ai/api/v1
